# Copy this file to .env and add your own credentials.
# Never commit the .env file: it is listed in .gitignore.

# Port for the Express API
PORT=4000

# MongoDB Atlas: Database > Connect > Drivers, then copy the connection string
# and replace YOUR_DB_USER, YOUR_DB_PASSWORD, YOUR_CLUSTER and YOUR_DATABASE.
MONGODB_CONNECTION_STRING=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE

# Secret used to sign login tokens. Use a long random string, for example the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=YOUR_LONG_RANDOM_SECRET
